<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PowerOfChaos.Launcher.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <SolidColorBrush x:Key="InkBrush">#0B0B0B</SolidColorBrush>
    <SolidColorBrush x:Key="PanelBrush">#121212</SolidColorBrush>
    <SolidColorBrush x:Key="LineBrush">#292929</SolidColorBrush>
    <SolidColorBrush x:Key="QuietBrush">#969696</SolidColorBrush>
    <SolidColorBrush x:Key="AccentBrush">#E5E5E5</SolidColorBrush>
    <Color x:Key="SystemAccentColor">#D5D5D5</Color>
    <Color x:Key="SystemAccentColorLight1">#E5E5E5</Color>
    <Color x:Key="SystemAccentColorLight2">#EBEBEB</Color>
    <Color x:Key="SystemAccentColorLight3">#F5F5F5</Color>
    <Color x:Key="SystemAccentColorDark1">#A3A3A3</Color>
    <Color x:Key="SystemAccentColorDark2">#737373</Color>
    <Color x:Key="SystemAccentColorDark3">#525252</Color>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="Background" Value="{StaticResource InkBrush}" />
      <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
      <Setter Property="Foreground" Value="#E7E7E7" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="TextBlock.quiet">
      <Setter Property="Foreground" Value="{StaticResource QuietBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource QuietBrush}" />
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Background" Value="#191919" />
      <Setter Property="Foreground" Value="#DFDFDF" />
      <Setter Property="BorderBrush" Value="#333333" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#262626" />
      <Setter Property="BorderBrush" Value="#484848" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#303030" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="#111111" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="#111111" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#BDBDBD" />
      <Setter Property="Foreground" Value="#111111" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="#191919" />
      <Setter Property="BorderBrush" Value="#333333" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.navigation">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#A3A3A3" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Margin" Value="0,2" />
    </Style>
    <Style Selector="Button.navigation.active">
      <Setter Property="Background" Value="#232323" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.navigation.active:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#2B2B2B" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="11,9" />
      <Setter Property="Background" Value="#101010" />
      <Setter Property="BorderBrush" Value="#3B3B3B" />
    </Style>
    <Style Selector="TextBox:focus">
      <Setter Property="BorderBrush" Value="#BDBDBD" />
    </Style>
    <Style Selector="MenuFlyoutPresenter">
      <Setter Property="Background" Value="#191919" />
      <Setter Property="BorderBrush" Value="#383838" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="5" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{StaticResource PanelBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="5" />
    </Style>
    <Style Selector="Border.notice">
      <Setter Property="Background" Value="#161616" />
      <Setter Property="BorderBrush" Value="#303030" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="14,11" />
    </Style>
  </Application.Styles>
</Application>
