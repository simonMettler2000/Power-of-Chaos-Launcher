<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PowerOfChaos.Launcher.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <SolidColorBrush x:Key="InkBrush">#101617</SolidColorBrush>
    <SolidColorBrush x:Key="PanelBrush">#182021</SolidColorBrush>
    <SolidColorBrush x:Key="LineBrush">#2D3838</SolidColorBrush>
    <SolidColorBrush x:Key="QuietBrush">#9AA9A6</SolidColorBrush>
    <SolidColorBrush x:Key="AccentBrush">#B8D5BE</SolidColorBrush>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="Background" Value="{StaticResource InkBrush}" />
      <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
      <Setter Property="Foreground" Value="#E8EEEA" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="TextBlock.quiet">
      <Setter Property="Foreground" Value="{StaticResource QuietBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource QuietBrush}" />
      <Setter Property="LetterSpacing" Value="2" />
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="27" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="-0.8" />
    </Style>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="#17231D" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#CCE4D0" />
      <Setter Property="Foreground" Value="#17231D" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="#202B2B" />
      <Setter Property="BorderBrush" Value="#374544" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.navigation">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#9AA9A6" />
      <Setter Property="Padding" Value="16,13" />
      <Setter Property="Margin" Value="0,3" />
    </Style>
    <Style Selector="Button.navigation.active">
      <Setter Property="Background" Value="#243331" />
      <Setter Property="Foreground" Value="#D8E9DB" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,11" />
      <Setter Property="Background" Value="#11191A" />
      <Setter Property="BorderBrush" Value="#3C4B49" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{StaticResource PanelBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
    </Style>
    <Style Selector="Border.notice">
      <Setter Property="Background" Value="#1D2D2A" />
      <Setter Property="BorderBrush" Value="#345148" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="14,12" />
    </Style>
  </Application.Styles>
</Application>
