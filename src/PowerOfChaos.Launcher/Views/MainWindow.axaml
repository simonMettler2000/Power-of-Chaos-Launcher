<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PowerOfChaos.Launcher.ViewModels"
        x:Class="PowerOfChaos.Launcher.Views.MainWindow"
        Title="Power of Chaos" Icon="avares://PowerOfChaos.Launcher/!__AvaloniaDefaultWindowIcon"
        Width="1100" Height="720" MinWidth="880" MinHeight="600"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <DataTemplate x:Key="CollectionCardTemplate" DataType="vm:CollectionCardViewModel">
      <Border Width="58" Height="80" Padding="3" Margin="0,0,6,6" Background="#171717"
              BorderBrush="#373737" BorderThickness="1" CornerRadius="3"
              ToolTip.Tip="{Binding Tooltip}" AutomationProperties.Name="{Binding Tooltip}">
        <Grid Width="50" Height="72">
          <TextBlock Text="?" Foreground="#777777" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Image Source="{Binding Artwork}" Width="{Binding ArtworkWidth}" Height="{Binding ArtworkHeight}"
                 Stretch="Uniform" StretchDirection="DownOnly" IsVisible="{Binding HasArtwork}"
                 Opacity="{Binding ArtworkOpacity}" RenderOptions.BitmapInterpolationMode="HighQuality" />
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>
  <Grid ColumnDefinitions="190,*">
    <Border BorderBrush="#242424" BorderThickness="0,0,1,0" Background="#101010">
      <Grid RowDefinitions="Auto,*,Auto" Margin="14,28,14,18">
        <StackPanel Spacing="6" Margin="12,0,0,32">
          <TextBlock Text="Power of Chaos" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="Launcher" Classes="caption" />
        </StackPanel>
        <StackPanel Grid.Row="1">
          <Button x:Name="LibraryNav" Classes="navigation active" Content="Games" Click="Library_Click" />
          <Button x:Name="CollectionNav" Classes="navigation" Content="Collection" Click="Collection_Click" />
          <Button x:Name="ModsNav" Classes="navigation" Content="Mods" Click="Mods_Click" />
          <Button x:Name="LocationsNav" Classes="navigation" Content="Game locations" Click="Locations_Click" />
        </StackPanel>
        <StackPanel Grid.Row="2" Spacing="8">
          <Button Content="About" Classes="navigation" Click="About_Click" />
          <Button x:Name="SettingsButton" Classes="navigation" AutomationProperties.Name="Settings" ToolTip.Tip="Settings">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Viewbox Width="18" Height="18">
                <Path Width="24" Height="24" Stroke="#C5C5C5" StrokeThickness="1.5" StrokeJoin="Round"
                      Data="M10,2 L14,2 L14.6,5 L16,5.8 L18.9,4.8 L21,8.2 L18.7,10.3 L18.7,13.7 L21,15.8 L18.9,19.2 L16,18.2 L14.6,19 L14,22 L10,22 L9.4,19 L8,18.2 L5.1,19.2 L3,15.8 L5.3,13.7 L5.3,10.3 L3,8.2 L5.1,4.8 L8,5.8 L9.4,5 Z M15.5,12 A3.5,3.5 0 1 1 8.5,12 A3.5,3.5 0 1 1 15.5,12" />
              </Viewbox>
              <TextBlock Text="Settings" VerticalAlignment="Center" />
            </StackPanel>
            <Button.Flyout>
              <MenuFlyout Placement="RightEdgeAlignedBottom">
                <MenuItem Header="Add Game path" Click="AddPath_Click" />
                <MenuItem Header="Game locations" Click="Locations_Click" />
                <MenuItem x:Name="RescanMenu" Header="Rescan game folders" Click="Rescan_Click" />
                <Separator />
                <MenuItem Header="Preferences" Click="Preferences_Click" />
                <MenuItem Header="About" Click="About_Click" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <TextBlock Text="Version 0.1" Classes="caption" FontSize="11" Margin="12,0,0,0" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" Margin="32,28,32,24">
      <StackPanel Spacing="7" Margin="0,0,0,28">
        <TextBlock x:Name="PageTitle" Text="Games" Classes="sectionTitle" />
        <TextBlock x:Name="PageSubtitle" Text="Your installed Power of Chaos games." Classes="quiet" />
      </StackPanel>
      <Border x:Name="StatusBanner" Grid.Row="1" Classes="notice" IsVisible="False" Margin="0,0,0,20">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
          <ScrollViewer MaxHeight="180" HorizontalScrollBarVisibility="Disabled">
            <SelectableTextBlock x:Name="StatusText" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.Name="Launcher status" Focusable="True" />
          </ScrollViewer>
          <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Top">
            <Button x:Name="CopyStatusButton" Content="Copy" Classes="secondary" Click="CopyStatus_Click" AutomationProperties.Name="Copy launcher message" />
            <Button x:Name="CancelRescanButton" Content="Cancel" Classes="secondary" IsVisible="False" Click="CancelRescan_Click" />
          </StackPanel>
        </Grid>
      </Border>
      <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
        <Grid>
          <StackPanel x:Name="LibraryView" Spacing="18">
            <Border x:Name="LibraryEmpty" Classes="panel" Padding="36,56" AutomationProperties.Name="Library empty state">
              <StackPanel HorizontalAlignment="Center" MaxWidth="400" Spacing="14">
                <TextBlock Text="no game path added" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" AutomationProperties.Name="No game path added" />
                <TextBlock Text="Choose a game folder, or a folder containing all three games." Classes="quiet" TextAlignment="Center" LineHeight="22" />
                <Button Content="Add Game path" Classes="primary" HorizontalAlignment="Center" Margin="0,8,0,0" Click="AddPath_Click" AutomationProperties.Name="Add Game path" />
              </StackPanel>
            </Border>
            <StackPanel x:Name="InstalledLibrary" Spacing="14" IsVisible="False">
              <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                <TextBlock x:Name="GameCount" Text="Installed games" Classes="caption" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Add folder" Classes="secondary" Click="AddPath_Click" />
              </Grid>
              <ItemsControl x:Name="GameCards">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:GameCardViewModel">
                    <Border Classes="panel" Margin="0,0,0,10" Padding="16,12">
                      <Grid ColumnDefinitions="112,*,76,80,96" ColumnSpacing="14">
                        <Grid Width="112" Height="104" ClipToBounds="True" VerticalAlignment="Center">
                          <Border Background="#191919" CornerRadius="4" IsVisible="{Binding ShowPortraitPlaceholder}">
                            <Path Width="24" Height="30" Stroke="#656565" StrokeThickness="1.5"
                                  Data="M3,1 L21,1 L21,29 L3,29 Z M7,7 L17,7 M7,12 L17,12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <Image x:Name="GamePortrait" Source="{Binding Portrait}" Stretch="Uniform" IsVisible="{Binding HasPortrait}"
                                 RenderOptions.BitmapInterpolationMode="HighQuality"
                                 AutomationProperties.Name="{Binding Title, StringFormat='Portrait of {0}'}" />
                        </Grid>
                        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Folder}" Classes="quiet" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Folder}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center">
                          <TextBlock Text="Cards" Classes="caption" FontSize="11" />
                          <TextBlock Text="{Binding CollectionCount}" FontSize="13" Foreground="#D4D4D4" ToolTip.Tip="{Binding CollectionMessage}"
                                     AutomationProperties.Name="{Binding Title, StringFormat='Card collection for {0}'}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Spacing="6" VerticalAlignment="Center">
                          <TextBlock Text="Playtime" Classes="caption" FontSize="11" />
                          <TextBlock Text="{Binding Playtime}" FontSize="13" Foreground="#D4D4D4" />
                        </StackPanel>
                        <Button Grid.Column="4" Content="{Binding PlayLabel}" Classes="primary" HorizontalAlignment="Stretch" VerticalAlignment="Center" HorizontalContentAlignment="Center" Tag="{Binding Installation}" IsEnabled="{Binding CanPlay}" Click="PlayGame_Click" AutomationProperties.Name="{Binding Title, StringFormat='Play {0}'}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <TextBlock Text="Playtime counts sessions started from this launcher." Classes="quiet" FontSize="11" Margin="0,0,0,8" />
          </StackPanel>
          <StackPanel x:Name="ModsView" Spacing="12" IsVisible="False">
            <StackPanel.Resources>
              <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked">#0078D4</SolidColorBrush>
              <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver">#168BE8</SolidColorBrush>
              <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed">#005FA3</SolidColorBrush>
              <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked">#FFFFFF</SolidColorBrush>
              <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver">#FFFFFF</SolidColorBrush>
              <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed">#FFFFFF</SolidColorBrush>
              <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked">#0078D4</SolidColorBrush>
              <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver">#168BE8</SolidColorBrush>
              <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPressed">#005FA3</SolidColorBrush>
            </StackPanel.Resources>
            <Border Classes="panel" Padding="20">
              <Grid x:Name="SkipSplashScreensRow" ColumnDefinitions="Auto,210,*" ColumnSpacing="20">
                <CheckBox x:Name="SkipSplashScreensCheckBox" VerticalAlignment="Center" IsEnabled="False"
                          AutomationProperties.Name="Skip Splash Screens for all three games" Click="SkipSplashScreens_Click" />
                <TextBlock x:Name="SkipSplashScreensTitle" Grid.Column="1" Text="Skip Splash Screens" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                <TextBlock x:Name="SkipSplashScreensDescription" Grid.Column="2" Text="Skip publisher logos in all three games. The title menu keeps its normal fade. Applies on the next launch." Classes="quiet" TextWrapping="Wrap" LineHeight="21" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <Border Classes="panel" Padding="20">
              <Grid x:Name="SkipCharacterInteractionsRow" ColumnDefinitions="Auto,210,*" ColumnSpacing="20">
                <CheckBox x:Name="SkipCharacterInteractionsCheckBox" IsEnabled="False" VerticalAlignment="Center"
                          AutomationProperties.Name="Skip character interactions for all three games" Click="SkipCharacterInteractions_Click" />
                <TextBlock x:Name="SkipCharacterInteractionsTitle" Grid.Column="1" Text="Skip character interactions" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                <TextBlock x:Name="SkipCharacterInteractionsDescription" Grid.Column="2" Text="Skip in-duel character dialogue and reaction pauses. Keep duel music and card sounds. Applies on the next launch." Classes="quiet" TextWrapping="Wrap" LineHeight="21" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <Border Classes="panel" Padding="20">
              <Grid x:Name="OriginalAspectRatioRow" ColumnDefinitions="Auto,210,*" ColumnSpacing="20">
                <CheckBox x:Name="OriginalAspectRatioCheckBox" IsEnabled="False" VerticalAlignment="Center"
                          AutomationProperties.Name="Original aspect ratio for all three games" Click="OriginalAspectRatio_Click" />
                <TextBlock x:Name="OriginalAspectRatioTitle" Grid.Column="1" Text="Original aspect ratio" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                <TextBlock x:Name="OriginalAspectRatioDescription" Grid.Column="2" Text="Start windowed and keep the original 4:3 picture when resizing, maximizing or using fullscreen, with black bars as needed. Retains normal game speed. Applies on the next launch." Classes="quiet" TextWrapping="Wrap" LineHeight="21" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <Border Classes="panel" Padding="20">
              <Grid ColumnDefinitions="Auto,210,*" ColumnSpacing="20">
                <CheckBox IsEnabled="False" VerticalAlignment="Center" AutomationProperties.Name="Custom opponent decks, in development" />
                <TextBlock Grid.Column="1" Text="Custom opponent decks" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="Change the decks used by the opponent. In development." Classes="quiet" TextWrapping="Wrap" LineHeight="21" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <Border Classes="panel" Padding="20">
              <Grid ColumnDefinitions="Auto,210,*" ColumnSpacing="20">
                <CheckBox IsEnabled="False" VerticalAlignment="Center" AutomationProperties.Name="New card rewards, in development" />
                <TextBlock Grid.Column="1" Text="New card rewards" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="Award new cards in their permitted quantities. In development." Classes="quiet" TextWrapping="Wrap" LineHeight="21" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <Border Classes="panel" Padding="20">
              <Grid ColumnDefinitions="Auto,210,*" ColumnSpacing="20">
                <CheckBox IsEnabled="False" VerticalAlignment="Center" AutomationProperties.Name="HD card artwork, in development" />
                <TextBlock Grid.Column="1" Text="HD card artwork" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="Support higher-resolution card images. In development." Classes="quiet" TextWrapping="Wrap" LineHeight="21" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </StackPanel>
          <StackPanel x:Name="CollectionView" Spacing="18" IsVisible="False">
            <Border Classes="panel" Padding="24">
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Unique cards" Classes="caption" />
                    <TextBlock x:Name="UniqueCardCount" Text="—/771" FontSize="32" FontWeight="SemiBold" AutomationProperties.Name="Unique cards across all games" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                    <Button Content="Choose save" Classes="secondary" Click="BrowseCollectionSave_Click" />
                    <Button x:Name="RefreshCollectionButton" Content="Refresh" Classes="secondary" Click="RefreshCollection_Click" />
                  </StackPanel>
                </Grid>
                <ProgressBar x:Name="UniqueCollectionProgress" Minimum="0" Maximum="771" Height="4" Foreground="#D4D4D4" Background="#292929" IsVisible="False" />
                <TextBlock x:Name="CollectionStatus" Text="Add a game folder to see your collection." Classes="quiet" LineHeight="21" />
              </StackPanel>
            </Border>
            <ItemsControl x:Name="CollectionGames">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:CollectionGameViewModel">
                  <Border Classes="panel" Padding="12" Margin="0,0,0,10">
                    <Expander x:Name="CollectionExpander" IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                      <Expander.Header>
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="12">
                          <StackPanel Spacing="6">
                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Message}" Classes="quiet" FontSize="12" />
                          </StackPanel>
                          <TextBlock Grid.Column="1" Text="{Binding Count}" FontSize="20" VerticalAlignment="Center"
                                     AutomationProperties.Name="{Binding Title, StringFormat='Collection progress for {0}'}" />
                          <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="100" Value="{Binding Percentage}"
                                       Height="3" Foreground="#D4D4D4" Background="#292929" IsVisible="{Binding HasCount}" />
                        </Grid>
                      </Expander.Header>
                      <StackPanel Spacing="12" Margin="8,12,8,4">
                        <TextBlock Text="{Binding GalleryStatus}" Classes="quiet" FontSize="12" />
                        <ScrollViewer MaxHeight="420" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasCards}">
                          <StackPanel Spacing="12">
                            <TextBlock Text="{Binding OwnedHeading}" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{Binding OwnedCards}" ItemTemplate="{StaticResource CollectionCardTemplate}">
                              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock Text="{Binding MissingHeading}" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{Binding MissingCards}" ItemTemplate="{StaticResource CollectionCardTemplate}">
                              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                          </StackPanel>
                        </ScrollViewer>
                      </StackPanel>
                    </Expander>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Spacing="10">
              <TextBlock Text="Collection save" Classes="caption" />
              <TextBlock Text="Read your shared system.dat automatically, or choose a save. Your save is never changed." Classes="quiet" FontSize="12" />
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <TextBox x:Name="CollectionSaveInput" Watermark="Automatic · shared system.dat" AutomationProperties.Name="Collection save path" />
                <Button Grid.Column="1" Content="Browse…" Click="BrowseCollectionSave_Click" Classes="secondary" />
                <Button Grid.Column="2" Content="Use path" Click="UseCollectionSave_Click" Classes="secondary" />
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="Use automatic location" Click="AutomaticCollectionSave_Click" Classes="secondary" />
                <TextBlock x:Name="CollectionSaveSource" Classes="quiet" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
          <StackPanel x:Name="LocationsView" Spacing="18" IsVisible="False">
            <TextBlock Text="Folders are searched up to six levels deep. Removing a location does not delete your game files." Classes="quiet" LineHeight="22" />
            <StackPanel x:Name="LocationRows" Spacing="12" />
            <StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Add Game path" Classes="primary" Click="AddPath_Click" /><Button x:Name="RescanButton" Content="Rescan folders" Classes="secondary" Click="Rescan_Click" /></StackPanel>
          </StackPanel>
          <StackPanel x:Name="AboutView" Spacing="18" IsVisible="False">
            <Border Classes="panel" Padding="24"><StackPanel Spacing="16"><TextBlock Text="Power of Chaos Launcher" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Version 0.1" Classes="caption" /><TextBlock Text="A launcher for Yugi the Destiny, Kaiba the Revenge and Joey the Passion. Built with C# and Avalonia for Windows, Linux and macOS." Classes="quiet" LineHeight="22" /><TextBlock Text="Linux and macOS require a compatible Wine runner, set in Preferences. Game and mod compatibility must be tested on each platform." Classes="quiet" LineHeight="22" /><TextBlock Text="This independent project includes no original game executables, archives, artwork, music or saves." Classes="quiet" FontSize="12" LineHeight="22" /></StackPanel></Border>
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
