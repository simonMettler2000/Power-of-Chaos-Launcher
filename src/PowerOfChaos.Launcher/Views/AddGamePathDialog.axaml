<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PowerOfChaos.Launcher.Views.AddGamePathDialog" Title="Add Game path" Width="590" Height="420"
        MinWidth="500" MinHeight="390" CanResize="False" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="30" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="18">
    <StackPanel Spacing="9"><TextBlock Text="CONNECT YOUR LIBRARY" Classes="eyebrow" /><TextBlock Text="Add Game path" Classes="sectionTitle" /><TextBlock Text="Choose one game folder, or a parent folder containing the trilogy. We’ll look up to six levels deeper." Classes="quiet" LineHeight="22" /></StackPanel>
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10">
      <TextBox x:Name="PathInput" Watermark="Paste a folder path…" AutomationProperties.Name="Game folder path" />
      <Button Grid.Column="1" Content="Browse…" Classes="secondary" Click="Browse_Click" AutomationProperties.Name="Browse game folder" />
    </Grid>
    <ProgressBar x:Name="ScanProgress" Grid.Row="2" IsIndeterminate="True" IsVisible="False" Height="3" />
    <TextBlock x:Name="ResultText" Grid.Row="3" Text="The launcher checks for the game executable and its data archives." Classes="quiet" TextWrapping="Wrap" LineHeight="22" AutomationProperties.Name="Discovery result" />
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
      <Button x:Name="CancelButton" Content="Cancel" Classes="secondary" Click="Cancel_Click" />
      <Button x:Name="ScanButton" Content="Find games" Classes="primary" IsEnabled="False" IsDefault="True" Click="Scan_Click" AutomationProperties.Name="Find games" />
    </StackPanel>
  </Grid>
</Window>
