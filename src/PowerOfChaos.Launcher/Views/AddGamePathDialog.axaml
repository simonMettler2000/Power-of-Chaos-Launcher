<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:PowerOfChaos.Launcher.Localization"
        x:Class="PowerOfChaos.Launcher.Views.AddGamePathDialog" Title="{loc:Tr Text='Add Game path'}" Width="590" Height="420"
        MinWidth="500" MinHeight="390" CanResize="False" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="30" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="18">
    <StackPanel Spacing="9"><TextBlock Text="{loc:Tr Text='Add Game path'}" Classes="sectionTitle" /><TextBlock Text="{loc:Tr Text='Choose a game folder, or a folder containing all three games. The search includes six folder levels.'}" Classes="quiet" LineHeight="22" TextWrapping="Wrap" /></StackPanel>
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10">
      <TextBox x:Name="PathInput" Watermark="{loc:Tr Text='Paste a folder path…'}" AutomationProperties.Name="{loc:Tr Text='Game folder path'}" />
      <Button Grid.Column="1" Content="{loc:Tr Text='Browse…'}" Classes="secondary" Click="Browse_Click" AutomationProperties.Name="{loc:Tr Text='Browse game folder'}" />
    </Grid>
    <ProgressBar x:Name="ScanProgress" Grid.Row="2" IsIndeterminate="True" IsVisible="False" Height="3" />
    <TextBlock x:Name="ResultText" Grid.Row="3" Text="{loc:Tr Text='The launcher checks for the game executable and its data archives.'}" Classes="quiet" TextWrapping="Wrap" LineHeight="22" AutomationProperties.Name="{loc:Tr Text='Discovery result'}" />
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
      <Button x:Name="CancelButton" Content="{loc:Tr Text='Cancel'}" Classes="secondary" Click="Cancel_Click" />
      <Button x:Name="ScanButton" Content="{loc:Tr Text='Find games'}" Classes="primary" IsEnabled="False" IsDefault="True" Click="Scan_Click" AutomationProperties.Name="{loc:Tr Text='Find games'}" />
    </StackPanel>
  </Grid>
</Window>
